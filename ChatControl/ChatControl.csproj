<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CounterStrikeSharp.API 1.0.371 ships a net10.0 assembly only, so the
         plugin has to target net10.0 as well. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChatControl</AssemblyName>
    <RootNamespace>ChatControl</RootNamespace>
    <!-- Produces a full ChatControl.deps.json so CounterStrikeSharp's plugin
         load context can resolve the assembly at runtime. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the runtime version of the target server. ExcludeAssets=runtime
         keeps CounterStrikeSharp.API.dll out of the deployed output — the server
         provides it, and shipping a second copy breaks plugin loading. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
